# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored: never commit real credentials.
#
# Where to find the values: Supabase dashboard → your project → "Connect" (top bar)
# → "Connection String" tab → choose the pooler type indicated below.
# Replace [YOUR-PASSWORD] with the database password set when the project was created.

# Runtime connection used by the web app and API (Vercel serverless functions).
# Supabase "Transaction pooler", port 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Long-lived connection for migrations (drizzle-kit) and ingest scripts.
# Supabase "Session pooler", port 5432 (works over IPv4, unlike the direct connection).
DATABASE_URL_DIRECT="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"
